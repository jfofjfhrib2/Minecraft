@import url(
    "https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
);

:root {
    --pixel: "Press Start 2P", monospace;
    --panel: rgba(8, 12, 17, 0.9);
}

* {
    box-sizing: border-box;
    image-rendering: pixelated;
    -webkit-tap-highlight-color: transparent;
}

html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #78badb;
    touch-action: none;
    overscroll-behavior: none;
    user-select: none;
}

body {
    font-family: Arial, sans-serif;
}

canvas {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: block;
    touch-action: none;
}

button {
    cursor: pointer;
    font-family: var(--pixel);
}

#menu,
#pause,
#inventory {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.62);
}

#pause,
#inventory {
    display: none;
}

.panel {
    width: min(92vw, 520px);
    max-height: 90vh;
    overflow: auto;
    padding: 26px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 15px;
    color: white;
    background: var(--panel);
    text-align: center;
}

.panel h1 {
    margin: 0 0 18px;
    color: #a1f291;
    font-family: var(--pixel);
    font-size: clamp(27px, 8vw, 53px);
    line-height: 1.4;
    text-shadow:
        0 5px 0 #2c7035,
        0 9px 15px #000;
}

.panel h2 {
    font-family: var(--pixel);
    font-size: 17px;
}

.panel p {
    font-size: 13px;
    line-height: 1.7;
}

.small {
    font-size: 10px !important;
}

.panel button {
    width: 100%;
    margin-top: 10px;
    padding: 15px;
    border: 0;
    border-radius: 8px;
    color: #071107;
    background: #91e991;
    font-size: 10px;
}

.panel button:active {
    transform: translateY(2px);
}

#hud {
    position: fixed;
    inset: 0;
    z-index: 10;
    pointer-events: none;
}

#crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 20px;
    height: 20px;
    transform: translate(-50%, -50%);
}

#crosshair::before,
#crosshair::after {
    position: absolute;
    content: "";
    background: white;
    box-shadow: 0 0 3px black;
}

#crosshair::before {
    left: 9px;
    width: 2px;
    height: 20px;
}

#crosshair::after {
    top: 9px;
    width: 20px;
    height: 2px;
}

#stats,
#help {
    position: absolute;
    top: 12px;
    padding: 9px;
    border-radius: 7px;
    color: white;
    background: rgba(0, 0, 0, 0.43);
    font-family: var(--pixel);
    font-size: 8px;
    line-height: 1.8;
}

#stats {
    left: 12px;
}

#help {
    right: 12px;
}

#selectedName {
    position: absolute;
    bottom: 100px;
    left: 50%;
    padding: 8px;
    border-radius: 6px;
    color: white;
    background: rgba(0, 0, 0, 0.5);
    font-family: var(--pixel);
    font-size: 8px;
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity 0.2s;
}

#hotbar {
    position: absolute;
    bottom: 13px;
    left: 50%;
    display: flex;
    gap: 4px;
    max-width: 96vw;
    overflow-x: auto;
    padding: 6px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.7);
    pointer-events: auto;
    transform: translateX(-50%);
}

.slot {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 3px solid rgba(255, 255, 255, 0.22);
    border-radius: 6px;
    background: #202a32;
}

.slot.selected {
    border-color: #fff28d;
    transform: translateY(-5px);
}

.slot-number,
.slot-count {
    position: absolute;
    color: white;
    font-family: var(--pixel);
    font-size: 7px;
    text-shadow: 0 1px 2px #000;
}

.slot-number {
    top: 3px;
    left: 4px;
}

.slot-count {
    right: 4px;
    bottom: 3px;
}

.preview {
    width: 26px;
    height: 26px;
    border: 2px solid rgba(0, 0, 0, 0.35);
}

#touchControls {
    position: fixed;
    inset: 0;
    z-index: 30;
    pointer-events: none;
}

.touchButton,
#touchControls button {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 57px;
    height: 57px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    color: white;
    background: rgba(0, 0, 0, 0.42);
    font-size: 20px;
    pointer-events: auto;
    touch-action: none;
}

#forward {
    bottom: 140px;
    left: 83px;
}

#left {
    bottom: 76px;
    left: 17px;
}

#back {
    bottom: 76px;
    left: 83px;
}

#right {
    bottom: 76px;
    left: 149px;
}

#jump {
    right: 22px;
    bottom: 140px;
}

#breakButton {
    right: 88px;
    bottom: 76px;
}

#placeButton {
    right: 22px;
    bottom: 76px;
}

#inventoryButton {
    top: 84px;
    right: 20px;
    width: 47px;
    height: 47px;
    font-size: 15px;
}

#inventoryGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: 8px;
    margin: 16px 0;
}

#inventoryGrid button {
    min-height: 75px;
    padding: 8px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    color: white;
    background: rgba(255, 255, 255, 0.1);
    font-size: 8px;
}

@media (min-width: 761px) {
    #touchControls {
        display: none;
    }
}

@media (max-width: 760px) {
    #help {
        display: none;
    }

    #hotbar {
        bottom: 8px;
    }

    .slot {
        width: 39px;
        height: 45px;
    }

    .preview {
        width: 21px;
        height: 21px;
    }

    #selectedName {
        bottom: 76px;
    }

    #stats {
        font-size: 7px;
    }
}
